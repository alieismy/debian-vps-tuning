#!/usr/bin/env bash
# Generated by tools/render_profiles.py. Internal single-phase collector.
set -Eeuo pipefail
IFS=$'\n\t'
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
EXIT_VERIFY=5
BENCHMARK_TIMEOUT_TERMINATE_GRACE_SECONDS=5
BENCHMARK_ACTIVE_CHILD_PID=''
BENCHMARK_ACTIVE_CHILD_PGID=''
runtime_status=0
warn() { printf '[measure-runtime] %s\n' "$*" >&2; }
info() { printf '[measure-runtime] %s\n' "$*"; }

@MEASUREMENT_COUNTERS@

@MEASUREMENT_PHASE@

main() {
  [ "$#" -eq 9 ] || { warn 'internal usage: IP PORT FAMILY IFACE CAP SECONDS OFFERED_BPS BLOCK_BYTES NEW_OUTPUT_DIR'; return 2; }
  BENCHMARK_HOST_RESOLVED="$1"
  BENCHMARK_PORT_RESOLVED="$2"
  BENCHMARK_FAMILY_ARGS=("--version${3}")
  local iface="$4" rate="$5" offered_bps="$7" block_bytes="$8" output_dir="$9"
  [[ "$1" =~ ^[0-9a-fA-F:.]+$ ]] && [[ "$2" =~ ^[0-9]{1,5}$ ]] || return 2
  [[ "$3" = 4 || "$3" = 6 ]] || return 2
  [[ "$iface" =~ ^[a-zA-Z0-9_.:-]{1,64}$ ]] || return 2
  [[ "$rate" =~ ^[0-9]{1,5}$ ]] && [ "$rate" -ge 1 ] && [ "$rate" -le 10000 ] || return 2
  [[ "$6" =~ ^[0-9]{1,2}$ ]] && [ "$6" -ge 5 ] && [ "$6" -le 30 ] || return 2
  [[ "$offered_bps" =~ ^[1-9][0-9]{0,10}$ ]] && [ "$offered_bps" -le "$((rate * 1000000))" ] || return 2
  [[ "$block_bytes" =~ ^[1-9][0-9]{0,5}$ ]] && [ "$block_bytes" -le 131072 ] || return 2
  [[ "$output_dir" = /* ]] && [ ! -e "$output_dir" ] && [ ! -L "$output_dir" ] || return 2
  # 内部执行器也核对父层预留，防止绕过调度器直接启动未记账流量。
  [[ "${DVT_TRAFFIC_LEDGER:-}" = /* ]] &&
    [[ "${DVT_MEASURE_RESERVATION:-}" =~ ^measure-[0-9a-f]{32}$ ]] || {
      warn '需要父层已完成的 measurement budget reservation。'; return 2;
    }
  local ledger_json minimum_bytes budget_tool
  budget_tool="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/dvt-traffic-budget.sh"
  ledger_json="$(bash "$budget_tool" status --ledger "$DVT_TRAFFIC_LEDGER")" || return 2
  minimum_bytes=$((rate * 125000 * ($6 + 10 + 8 + 5) + 1048576))
  jq -e --arg id "$DVT_MEASURE_RESERVATION" --argjson minimum "$minimum_bytes" '
    any(.entries[]; .reservation_id == $id and .run_id == $id and .tool == "measure" and
        .status == "RESERVED" and .planned_bytes >= $minimum)
  ' <<<"$ledger_json" >/dev/null || { warn '父层预留不存在、已结算或不足。'; return 2; }
  BENCHMARK_SECONDS_RESOLVED="$6"
  BENCHMARK_OMIT_RESOLVED=0
  BENCHMARK_PARALLEL_RESOLVED=1
  BENCHMARK_PHASE_TIMEOUT_RESOLVED=$((BENCHMARK_SECONDS_RESOLVED + 10))
  BENCHMARK_RATE_ARGS=(--bitrate "$offered_bps" --length "$block_bytes")
  umask 077
  mkdir -m 0700 -- "$output_dir"
  printf '%s\n' "$iface" >"${output_dir}/ifaces"
  trap 'runtime_status=$?; benchmark_reap_active_child; printf "[measure-runtime] stage=%s exit=%s\n" "${benchmark_failure_stage:-collection}" "$runtime_status"; exit "$runtime_status"' EXIT
  trap 'benchmark_handle_signal INT 130' INT
  trap 'benchmark_handle_signal TERM 143' TERM
  run_benchmark_phase upload 0 "$output_dir" "${output_dir}/ifaces"
}

if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then main "$@"; fi
